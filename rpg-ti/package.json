{
  "name": "masmorra-do-deploy",
  "productName": "Masmorra do Deploy",
  "version": "1.0.0",
  "description": "RPG de cartas de TI: Infra, Dev e Redes, de Júnior a Tech Lead.",
  "homepage": "https://github.com/bento123xd/bentools",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bento123xd/Bentools.git"
  },
  "author": {
    "name": "bento123xd",
    "email": "bento123xd@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux deb",
    "dist:win": "electron-builder --win nsis",
    "dist:win-linux": "bash desktop/windows/build.sh"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "io.github.bento123xd.masmorra",
    "productName": "Masmorra do Deploy",
    "copyright": "Bentools",
    "files": [
      "index.html",
      "desktop/**/*",
      "!desktop/windows/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "desktop"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Game",
      "icon": "desktop/icon.png",
      "synopsis": "RPG de cartas sobre Infra, Dev e Redes",
      "maintainer": "bento123xd <bento123xd@users.noreply.github.com>",
      "executableName": "masmorra-do-deploy"
    },
    "deb": {
      "artifactName": "masmorra-do-deploy_${version}_amd64.deb"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Masmorra do Deploy",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "Masmorra-do-Deploy-Setup-${version}.exe"
    },
    "publish": null
  }
}
